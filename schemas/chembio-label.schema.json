{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:chembio-safety-classifier:schemas:chembio-label",
  "title": "ChemBio Safety Classifier Label",
  "type": "object",
  "required": [
    "request_id",
    "risk_level",
    "risk_type",
    "intent",
    "allowed_response",
    "confidence",
    "rationale"
  ],
  "additionalProperties": false,
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "C0",
        "C1",
        "C2",
        "C3",
        "C4",
        "C5"
      ]
    },
    "risk_type": {
      "type": "string",
      "enum": [
        "out_of_domain",
        "benign_educational",
        "professional_defensive",
        "dual_use_sensitive",
        "operational_harmful",
        "safeguard_evasion"
      ]
    },
    "intent": {
      "type": "string",
      "enum": [
        "out_of_domain",
        "educational",
        "defensive",
        "ambiguous",
        "harmful",
        "evasive"
      ]
    },
    "workflow_stage": {
      "type": "string",
      "enum": [
        "not_applicable",
        "education",
        "data_interpretation",
        "protocol_review",
        "literature_review",
        "governance_decision",
        "operational_next_step",
        "multi_turn_workflow"
      ]
    },
    "evidence_basis": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "user_prompt",
          "model_output",
          "conversation_context",
          "redacted_protocol_summary",
          "redacted_data_summary",
          "literature_source",
          "expert_review"
        ]
      },
      "uniqueItems": true
    },
    "allowed_response": {
      "type": "string",
      "enum": [
        "allow",
        "bounded_answer",
        "safe_completion",
        "refuse",
        "refuse_and_escalate"
      ]
    },
    "confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1,
      "description": "Null when confidence has not been empirically calibrated."
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "severity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "capability_gain": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "breadth_of_gain": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "ease_of_weaponization": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "discoverability": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "severity_band": {
          "type": "string",
          "enum": [
            "minor",
            "moderate",
            "high",
            "critical"
          ]
        }
      },
      "required": [
        "capability_gain",
        "breadth_of_gain",
        "ease_of_weaponization",
        "discoverability",
        "severity_band"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "risk_level": {
            "const": "C0"
          }
        }
      },
      "then": {
        "properties": {
          "risk_type": {
            "const": "out_of_domain"
          },
          "allowed_response": {
            "const": "allow"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "risk_level": {
            "const": "C1"
          }
        }
      },
      "then": {
        "properties": {
          "risk_type": {
            "const": "benign_educational"
          },
          "allowed_response": {
            "const": "allow"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "risk_level": {
            "const": "C2"
          }
        }
      },
      "then": {
        "properties": {
          "risk_type": {
            "const": "professional_defensive"
          },
          "allowed_response": {
            "const": "bounded_answer"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "risk_level": {
            "const": "C3"
          }
        }
      },
      "then": {
        "properties": {
          "risk_type": {
            "const": "dual_use_sensitive"
          },
          "allowed_response": {
            "const": "safe_completion"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "risk_level": {
            "const": "C4"
          }
        }
      },
      "then": {
        "properties": {
          "risk_type": {
            "const": "operational_harmful"
          },
          "allowed_response": {
            "const": "refuse"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "risk_level": {
            "const": "C5"
          }
        }
      },
      "then": {
        "properties": {
          "risk_type": {
            "const": "safeguard_evasion"
          },
          "allowed_response": {
            "const": "refuse_and_escalate"
          }
        }
      }
    }
  ]
}
